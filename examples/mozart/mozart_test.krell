extern write(i64, ptr, i64) -> i64
extern malloc(i64) -> ptr
extern sin(f64) -> f64
extern pow(f64, f64) -> f64
extern exp(f64) -> f64
extern atoi(ptr) -> i32
data evstart: i32 = {
  8820, 8820, 8820, 8820, 8820, 8820
