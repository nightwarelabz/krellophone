extern write(i32, ptr, i64) -> i64
extern malloc(i64) -> ptr
extern atoi(ptr) -> i32
extern sin(f64) -> f64
extern cos(f64) -> f64
extern sqrt(f64) -> f64
extern exp(f64) -> f64

data dh1: i8 = { 80, 54, 10 }
data dsp: i8 = { 32 }
data dh2: i8 = { 10, 50, 53, 53, 10 }

fn wh1() -> void {
  entry():
    %_s0 = iconst i64 0
    %_s1 = iconst i32 0
    %_s2 = iconst i8 0
    %_s3 = iconst i64 1
    %_s4 = iconst i32 1
    %_s5 = iconst i8 1
    %_s6 = iconst i64 3
    %_s7 = iconst i32 3
    %_s8 = iconst i8 3
    %p = dataptr 0
    %r = call i64 write(1, %p, 3)
    ret
}
fn wsp() -> void {
  entry():
    %_s0 = iconst i64 1
    %_s1 = iconst i32 1
    %_s2 = iconst i8 1
    %p = dataptr 1
    %r = call i64 write(1, %p, 1)
    ret
}
fn wh2() -> void {
  entry():
    %_s0 = iconst i64 1
    %_s1 = iconst i32 1
    %_s2 = iconst i8 1
    %_s3 = iconst i64 2
    %_s4 = iconst i32 2
    %_s5 = iconst i8 2
    %_s6 = iconst i64 5
    %_s7 = iconst i32 5
    %_s8 = iconst i8 5
    %p = dataptr 2
    %r = call i64 write(1, %p, 5)
    ret
}

fn print_u64(i64) -> void {
  entry(x: i64):
    %_s0 = iconst i64 0
    %_s1 = iconst i32 0
    %_s2 = iconst i8 0
    %_s3 = iconst i64 1
    %_s4 = iconst i32 1
    %_s5 = iconst i8 1
    %_s6 = iconst i64 10
    %_s7 = iconst i32 10
    %_s8 = iconst i8 10
    %_s9 = iconst i64 24
    %_s10 = iconst i32 24
    %_s11 = iconst i8 24
    %_s12 = iconst i64 32
    %_s13 = iconst i32 32
    %_s14 = iconst i8 32
    %_s15 = iconst i64 48
    %_s16 = iconst i32 48
    %_s17 = iconst i8 48
    %buf = call ptr malloc(32)
    %z = icmp.eq i64 x, 0
    condbr %z, zero(%buf), loop(24, x, %buf)
  zero(buf: ptr):
    %p = gep i8 buf, 0
    store i8 %p, 48
    %w = call i64 write(1, buf, 1)
    ret
  loop(pos: i64, x: i64, buf: ptr):
    %done = icmp.sle i64 x, 0
    condbr %done, dump(pos, buf), body(pos, x, buf)
  body(pos: i64, x: i64, buf: ptr):
    %d = urem i64 x, 10
    %ch = add i64 %d, 48
    %ch8 = trunc i8 %ch
    %p2 = sub i64 pos, 1
    %pp = gep i8 buf, %p2
    store i8 %pp, %ch8
    %x2 = udiv i64 x, 10
    br loop(%p2, %x2, buf)
  dump(pos: i64, buf: ptr):
    %pp = gep i8 buf, pos
    %len = sub i64 24, pos
    %w = call i64 write(1, %pp, %len)
    ret
}

fn clamp01(f64) -> f64 {
  entry(v: f64):
    %_s0 = fconst f64 0.0
    %_s1 = fconst f64 1.0
    %lo = fcmp.olt f64 v, 0.0
    %a = select f64 %lo, 0.0, v
    %hi = fcmp.ogt f64 %a, 1.0
    %b = select f64 %hi, 1.0, %a
    ret %b
}

fn clamp255(f64) -> f64 {
  entry(v: f64):
    %_s0 = fconst f64 0.0
    %_s1 = fconst f64 255.0
    %lo = fcmp.olt f64 v, 0.0
    %a = select f64 %lo, 0.0, v
    %hi = fcmp.ogt f64 %a, 255.0
    %b = select f64 %hi, 255.0, %a
    ret %b
}

fn zero_canvas(ptr, i64) -> void {
  entry(buf: ptr, n: i64):
    %_s0 = iconst i64 0
    %_s1 = iconst i32 0
    %_s2 = iconst i8 0
    %_s3 = iconst i64 1
    %_s4 = iconst i32 1
    %_s5 = iconst i8 1
    %_s6 = fconst f64 0.0
    br loop(0, buf, n)
  loop(i: i64, buf: ptr, n: i64):
    %done = icmp.sge i64 i, n
    condbr %done, fin(), body(i, buf, n)
  body(i: i64, buf: ptr, n: i64):
    %p = gep f64 buf, i
    store f64 %p, 0.0
    %i2 = add i64 i, 1
    br loop(%i2, buf, n)
  fin():
    ret
}

; soft 5x5 stamp into the float canvas at (ix, iy); caller
; guarantees 2 <= ix, iy <= S-3.
fn splat(ptr, i64, i64, i64, f64) -> void {
  entry(buf: ptr, S: i64, ix: i64, iy: i64, w: f64):
    %_s0 = iconst i64 1
    %_s1 = iconst i32 1
    %_s2 = iconst i8 1
    %_s3 = iconst i64 2
    %_s4 = iconst i32 2
    %_s5 = iconst i8 2
    %_s6 = fconst f64 0.03
    %_s7 = fconst f64 0.05
    %_s8 = fconst f64 0.1
    %_s9 = fconst f64 0.22
    %_s10 = fconst f64 0.45
    %row = mul i64 iy, S
    %c = add i64 %row, ix
    %s2 = mul i64 S, 2
    %rm2 = sub i64 %c, %s2
    %rm1 = sub i64 %c, S
    %rp1 = add i64 %c, S
    %rp2 = add i64 %c, %s2
    %a0 = gep f64 buf, %c
    %v0 = load f64, %a0
    %n0 = fadd f64 %v0, w
    store f64 %a0, %n0
    %t1 = add i64 %c, 1
    %w1 = fmul f64 w, 0.45
    %a1 = gep f64 buf, %t1
    %v1 = load f64, %a1
    %n1 = fadd f64 %v1, %w1
    store f64 %a1, %n1
    %t2 = sub i64 %c, 1
    %w2 = fmul f64 w, 0.45
    %a2 = gep f64 buf, %t2
    %v2 = load f64, %a2
    %n2 = fadd f64 %v2, %w2
    store f64 %a2, %n2
    %w3 = fmul f64 w, 0.45
    %a3 = gep f64 buf, %rp1
    %v3 = load f64, %a3
    %n3 = fadd f64 %v3, %w3
    store f64 %a3, %n3
    %w4 = fmul f64 w, 0.45
    %a4 = gep f64 buf, %rm1
    %v4 = load f64, %a4
    %n4 = fadd f64 %v4, %w4
    store f64 %a4, %n4
    %t5 = add i64 %rp1, 1
    %w5 = fmul f64 w, 0.22
    %a5 = gep f64 buf, %t5
    %v5 = load f64, %a5
    %n5 = fadd f64 %v5, %w5
    store f64 %a5, %n5
    %t6 = add i64 %rm1, 1
    %w6 = fmul f64 w, 0.22
    %a6 = gep f64 buf, %t6
    %v6 = load f64, %a6
    %n6 = fadd f64 %v6, %w6
    store f64 %a6, %n6
    %t7 = sub i64 %rp1, 1
    %w7 = fmul f64 w, 0.22
    %a7 = gep f64 buf, %t7
    %v7 = load f64, %a7
    %n7 = fadd f64 %v7, %w7
    store f64 %a7, %n7
    %t8 = sub i64 %rm1, 1
    %w8 = fmul f64 w, 0.22
    %a8 = gep f64 buf, %t8
    %v8 = load f64, %a8
    %n8 = fadd f64 %v8, %w8
    store f64 %a8, %n8
    %t9 = add i64 %c, 2
    %w9 = fmul f64 w, 0.1
    %a9 = gep f64 buf, %t9
    %v9 = load f64, %a9
    %n9 = fadd f64 %v9, %w9
    store f64 %a9, %n9
    %t10 = sub i64 %c, 2
    %w10 = fmul f64 w, 0.1
    %a10 = gep f64 buf, %t10
    %v10 = load f64, %a10
    %n10 = fadd f64 %v10, %w10
    store f64 %a10, %n10
    %w11 = fmul f64 w, 0.1
    %a11 = gep f64 buf, %rp2
    %v11 = load f64, %a11
    %n11 = fadd f64 %v11, %w11
    store f64 %a11, %n11
    %w12 = fmul f64 w, 0.1
    %a12 = gep f64 buf, %rm2
    %v12 = load f64, %a12
    %n12 = fadd f64 %v12, %w12
    store f64 %a12, %n12
    %t13 = add i64 %rp1, 2
    %w13 = fmul f64 w, 0.05
    %a13 = gep f64 buf, %t13
    %v13 = load f64, %a13
    %n13 = fadd f64 %v13, %w13
    store f64 %a13, %n13
    %t14 = add i64 %rm1, 2
    %w14 = fmul f64 w, 0.05
    %a14 = gep f64 buf, %t14
    %v14 = load f64, %a14
    %n14 = fadd f64 %v14, %w14
    store f64 %a14, %n14
    %t15 = sub i64 %rp1, 2
    %w15 = fmul f64 w, 0.05
    %a15 = gep f64 buf, %t15
    %v15 = load f64, %a15
    %n15 = fadd f64 %v15, %w15
    store f64 %a15, %n15
    %t16 = sub i64 %rm1, 2
    %w16 = fmul f64 w, 0.05
    %a16 = gep f64 buf, %t16
    %v16 = load f64, %a16
    %n16 = fadd f64 %v16, %w16
    store f64 %a16, %n16
    %t17 = add i64 %rp2, 1
    %w17 = fmul f64 w, 0.05
    %a17 = gep f64 buf, %t17
    %v17 = load f64, %a17
    %n17 = fadd f64 %v17, %w17
    store f64 %a17, %n17
    %t18 = add i64 %rm2, 1
    %w18 = fmul f64 w, 0.05
    %a18 = gep f64 buf, %t18
    %v18 = load f64, %a18
    %n18 = fadd f64 %v18, %w18
    store f64 %a18, %n18
    %t19 = sub i64 %rp2, 1
    %w19 = fmul f64 w, 0.05
    %a19 = gep f64 buf, %t19
    %v19 = load f64, %a19
    %n19 = fadd f64 %v19, %w19
    store f64 %a19, %n19
    %t20 = sub i64 %rm2, 1
    %w20 = fmul f64 w, 0.05
    %a20 = gep f64 buf, %t20
    %v20 = load f64, %a20
    %n20 = fadd f64 %v20, %w20
    store f64 %a20, %n20
    %t21 = add i64 %rp2, 2
    %w21 = fmul f64 w, 0.03
    %a21 = gep f64 buf, %t21
    %v21 = load f64, %a21
    %n21 = fadd f64 %v21, %w21
    store f64 %a21, %n21
    %t22 = add i64 %rm2, 2
    %w22 = fmul f64 w, 0.03
    %a22 = gep f64 buf, %t22
    %v22 = load f64, %a22
    %n22 = fadd f64 %v22, %w22
    store f64 %a22, %n22
    %t23 = sub i64 %rp2, 2
    %w23 = fmul f64 w, 0.03
    %a23 = gep f64 buf, %t23
    %v23 = load f64, %a23
    %n23 = fadd f64 %v23, %w23
    store f64 %a23, %n23
    %t24 = sub i64 %rm2, 2
    %w24 = fmul f64 w, 0.03
    %a24 = gep f64 buf, %t24
    %v24 = load f64, %a24
    %n24 = fadd f64 %v24, %w24
    store f64 %a24, %n24
    ret
}

; 2584 = F(18) phyllotaxis seeds: angle k * golden angle, radius ~ sqrt(k).
fn seed_pass(ptr, i64, f64, f64, f64) -> void {
  entry(buf: ptr, S: i64, rot: f64, pulse: f64, ph: f64):
    %_s0 = iconst i64 0
    %_s1 = iconst i32 0
    %_s2 = iconst i8 0
    %_s3 = iconst i64 1
    %_s4 = iconst i32 1
    %_s5 = iconst i8 1
    %_s6 = iconst i64 2584
    %_s7 = iconst i32 2584
    %_s8 = iconst i8 2584
    %_s9 = fconst f64 0.30
    %_s10 = fconst f64 0.46
    %_s11 = fconst f64 0.5
    %_s12 = fconst f64 0.55
    %_s13 = fconst f64 0.6180339887498949
    %_s14 = fconst f64 1.0
    %_s15 = fconst f64 1.18
    %_s16 = fconst f64 2.39996322972865332
    %_s17 = fconst f64 2584.0
    %_s18 = fconst f64 31.41592653589793
    %sf = sitofp f64 S
    %rmax = fmul f64 %sf, 0.46
    %half = fmul f64 %sf, 0.5
    br loop(0, buf, S, rot, pulse, ph, %rmax, %half)
  loop(k: i64, buf: ptr, S: i64, rot: f64, pulse: f64, ph: f64, rmax: f64, half: f64):
    %done = icmp.sge i64 k, 2584
    condbr %done, fin(), body(k, buf, S, rot, pulse, ph, rmax, half)
  body(k: i64, buf: ptr, S: i64, rot: f64, pulse: f64, ph: f64, rmax: f64, half: f64):
    %kf = sitofp f64 k
    %kp = fadd f64 %kf, 0.5
    %fr0 = fdiv f64 %kp, 2584.0
    %fr = call f64 sqrt(%fr0)
    %rr0 = fmul f64 %fr, rmax
    %r = fmul f64 %rr0, pulse
    %ang0 = fmul f64 %kf, 2.39996322972865332
    %ang = fadd f64 %ang0, rot
    %ca = call f64 cos(%ang)
    %sa = call f64 sin(%ang)
    %dx = fmul f64 %r, %ca
    %dy = fmul f64 %r, %sa
    %x = fadd f64 half, %dx
    %y = fadd f64 half, %dy
    %sh0 = fmul f64 ph, 31.41592653589793
    %sh1 = fmul f64 %kf, 0.6180339887498949
    %sh2 = fadd f64 %sh0, %sh1
    %sh = call f64 sin(%sh2)
    %w0 = fmul f64 %sh, 0.30
    %w1 = fadd f64 %w0, 1.0
    %fall0 = fmul f64 %fr, 0.55
    %fall = fsub f64 1.18, %fall0
    %w = fmul f64 %w1, %fall
    %ix = fptosi i64 %x
    %iy = fptosi i64 %y
    call void splat(buf, S, %ix, %iy, %w)
    %k2 = add i64 k, 1
    br loop(%k2, buf, S, rot, pulse, ph, rmax, half)
  fin():
    ret
}

; the golden log spiral: radius grows by phi every half turn,
; sampled 9000 times, counter-rotating against the seed field.
fn spiral_pass(ptr, i64, f64) -> void {
  entry(buf: ptr, S: i64, rot: f64):
    %_s0 = iconst i64 0
    %_s1 = iconst i32 0
    %_s2 = iconst i8 0
    %_s3 = iconst i64 1
    %_s4 = iconst i32 1
    %_s5 = iconst i8 1
    %_s6 = iconst i64 9000
    %_s7 = iconst i32 9000
    %_s8 = iconst i8 9000
    %_s9 = fconst f64 0.00362
    %_s10 = fconst f64 0.03
    %_s11 = fconst f64 0.13
    %_s12 = fconst f64 0.1532
    %_s13 = fconst f64 0.46
    %_s14 = fconst f64 0.5
    %_s15 = fconst f64 1.0
    %_s16 = fconst f64 147.1
    %sf = sitofp f64 S
    %rmax = fmul f64 %sf, 0.46
    %half = fmul f64 %sf, 0.5
    %rscale = fdiv f64 %rmax, 147.1
    br loop(0, buf, S, rot, %rmax, %half, %rscale)
  loop(s: i64, buf: ptr, S: i64, rot: f64, rmax: f64, half: f64, rscale: f64):
    %done = icmp.sge i64 s, 9000
    condbr %done, fin(), body(s, buf, S, rot, rmax, half, rscale)
  body(s: i64, buf: ptr, S: i64, rot: f64, rmax: f64, half: f64, rscale: f64):
    %sf2 = sitofp f64 s
    %th = fmul f64 %sf2, 0.00362
    %ex0 = fmul f64 %th, 0.1532
    %ex = call f64 exp(%ex0)
    %r = fmul f64 %ex, rscale
    %ang = fsub f64 %th, rot
    %ca = call f64 cos(%ang)
    %sa = call f64 sin(%ang)
    %dx = fmul f64 %r, %ca
    %dy = fmul f64 %r, %sa
    %x = fadd f64 half, %dx
    %y = fadd f64 half, %dy
    %fd0 = fdiv f64 %r, rmax
    %fd1 = fsub f64 1.0, %fd0
    %fd2 = fmul f64 %fd1, 0.13
    %w = fadd f64 %fd2, 0.03
    %ix = fptosi i64 %x
    %iy = fptosi i64 %y
    call void splat(buf, S, %ix, %iy, %w)
    %s2 = add i64 s, 1
    br loop(%s2, buf, S, rot, rmax, half, rscale)
  fin():
    ret
}

; tone-map one pixel: deep blue field + gold light + white-hot core.
fn shade(ptr, i64, i64, i64, ptr) -> void {
  entry(buf: ptr, S: i64, x: i64, y: i64, row: ptr):
    %_s0 = iconst i64 1
    %_s1 = iconst i32 1
    %_s2 = iconst i8 1
    %_s3 = iconst i64 2
    %_s4 = iconst i32 2
    %_s5 = iconst i8 2
    %_s6 = iconst i64 3
    %_s7 = iconst i32 3
    %_s8 = iconst i8 3
    %_s9 = fconst f64 0.0
    %_s10 = fconst f64 0.25
    %_s11 = fconst f64 0.30
    %_s12 = fconst f64 0.5
    %_s13 = fconst f64 0.8
    %_s14 = fconst f64 1.0
    %_s15 = fconst f64 1.05
    %_s16 = fconst f64 1.55
    %_s17 = fconst f64 165.0
    %_s18 = fconst f64 18.0
    %_s19 = fconst f64 22.0
    %_s20 = fconst f64 235.0
    %_s21 = fconst f64 26.0
    %_s22 = fconst f64 40.0
    %_s23 = fconst f64 5.0
    %_s24 = fconst f64 70.0
    %_s25 = fconst f64 8.0
    %_s26 = fconst f64 80.0
    %_s27 = fconst f64 85.0
    %_s28 = fconst f64 90.0
    %idx0 = mul i64 y, S
    %idx = add i64 %idx0, x
    %cp = gep f64 buf, %idx
    %v = load f64, %cp
    %sf = sitofp f64 S
    %half = fmul f64 %sf, 0.5
    %xf = sitofp f64 x
    %yf = sitofp f64 y
    %dx0 = fsub f64 %xf, %half
    %dx = fdiv f64 %dx0, %half
    %dy0 = fsub f64 %yf, %half
    %dy = fdiv f64 %dy0, %half
    %dx2 = fmul f64 %dx, %dx
    %dy2 = fmul f64 %dy, %dy
    %d2 = fadd f64 %dx2, %dy2
    %d = call f64 sqrt(%d2)
    %t0 = fsub f64 1.0, %d
    %t = call f64 clamp01(%t0)
    %t2 = fmul f64 %t, %t
    %bgr0 = fmul f64 %t2, 18.0
    %bgr = fadd f64 %bgr0, 5.0
    %bgg0 = fmul f64 %t2, 22.0
    %bgg = fadd f64 %bgg0, 8.0
    %bgb0 = fmul f64 %t2, 40.0
    %bgb = fadd f64 %bgb0, 26.0
    %e0 = fmul f64 %v, 1.55
    %e1 = fsub f64 0.0, %e0
    %e2 = call f64 exp(%e1)
    %g = fsub f64 1.0, %e2
    %tr0 = fmul f64 %d, 0.25
    %tr = fsub f64 1.05, %tr0
    %tb0 = fmul f64 %d, 0.5
    %tb = fadd f64 %tb0, 0.8
    %ar0 = fmul f64 %g, 235.0
    %ar = fmul f64 %ar0, %tr
    %ag = fmul f64 %g, 165.0
    %ab0 = fmul f64 %g, 70.0
    %ab = fmul f64 %ab0, %tb
    %h = fmul f64 %g, %g
    %hr = fmul f64 %h, 90.0
    %hg = fmul f64 %h, 85.0
    %hb = fmul f64 %h, 80.0
    %vg0 = fmul f64 %d2, 0.30
    %vg = fsub f64 1.0, %vg0
    %rr0 = fadd f64 %bgr, %ar
    %rr1 = fadd f64 %rr0, %hr
    %rr = fmul f64 %rr1, %vg
    %gg0 = fadd f64 %bgg, %ag
    %gg1 = fadd f64 %gg0, %hg
    %gg = fmul f64 %gg1, %vg
    %bb0 = fadd f64 %bgb, %ab
    %bb1 = fadd f64 %bb0, %hb
    %bb = fmul f64 %bb1, %vg
    %rc = call f64 clamp255(%rr)
    %gc = call f64 clamp255(%gg)
    %bc = call f64 clamp255(%bb)
    %ri = fptosi i64 %rc
    %gi = fptosi i64 %gc
    %bi = fptosi i64 %bc
    %o0 = mul i64 x, 3
    %rp = gep i8 row, %o0
    %r8 = trunc i8 %ri
    store i8 %rp, %r8
    %o1 = add i64 %o0, 1
    %gp = gep i8 row, %o1
    %g8 = trunc i8 %gi
    store i8 %gp, %g8
    %o2 = add i64 %o0, 2
    %bp = gep i8 row, %o2
    %b8 = trunc i8 %bi
    store i8 %bp, %b8
    ret
}

fn render_row(ptr, i64, i64, ptr) -> void {
  entry(buf: ptr, S: i64, y: i64, row: ptr):
    %_s0 = iconst i64 0
    %_s1 = iconst i32 0
    %_s2 = iconst i8 0
    %_s3 = iconst i64 1
    %_s4 = iconst i32 1
    %_s5 = iconst i8 1
    br loop(0, buf, S, y, row)
  loop(x: i64, buf: ptr, S: i64, y: i64, row: ptr):
    %done = icmp.sge i64 x, S
    condbr %done, fin(), body(x, buf, S, y, row)
  body(x: i64, buf: ptr, S: i64, y: i64, row: ptr):
    call void shade(buf, S, x, y, row)
    %x2 = add i64 x, 1
    br loop(%x2, buf, S, y, row)
  fin():
    ret
}

fn main(i32, ptr) -> i32 {
  entry(argc: i32, argv: ptr):
    %_s0 = iconst i64 0
    %_s1 = iconst i32 0
    %_s2 = iconst i8 0
    %_s3 = iconst i64 1
    %_s4 = iconst i32 1
    %_s5 = iconst i8 1
    %_s6 = iconst i64 2
    %_s7 = iconst i32 2
    %_s8 = iconst i8 2
    %_s9 = iconst i64 3
    %_s10 = iconst i32 3
    %_s11 = iconst i8 3
    %_s12 = iconst i64 4
    %_s13 = iconst i32 4
    %_s14 = iconst i8 4
    %_s15 = iconst i64 8
    %_s16 = iconst i32 8
    %_s17 = iconst i8 8
    %_s18 = iconst i64 288
    %_s19 = iconst i32 288
    %_s20 = iconst i8 288
    %_s21 = iconst i64 960
    %_s22 = iconst i32 960
    %_s23 = iconst i8 960
    %_s24 = fconst f64 0.035
    %_s25 = fconst f64 1.0
    %_s26 = fconst f64 12.566370614359172
    %_s27 = fconst f64 6.283185307179586
    %h1 = icmp.sge i32 argc, 2
    condbr %h1, a1(argc, argv), setup(0, 288, 960)
  a1(argc: i32, argv: ptr):
    %p1 = gep ptr argv, 1
    %s1 = load ptr, %p1
    %av1 = call i32 atoi(%s1)
    %fr = sext i64 %av1
    %h2 = icmp.sge i32 argc, 3
    condbr %h2, a2(argc, argv, %fr), setup(%fr, 288, 960)
  a2(argc: i32, argv: ptr, fr: i64):
    %p2 = gep ptr argv, 2
    %s2 = load ptr, %p2
    %av2 = call i32 atoi(%s2)
    %tot = sext i64 %av2
    %h3 = icmp.sge i32 argc, 4
    condbr %h3, a3(argv, fr, %tot), setup(fr, %tot, 960)
  a3(argv: ptr, fr: i64, tot: i64):
    %p3 = gep ptr argv, 3
    %s3 = load ptr, %p3
    %av3 = call i32 atoi(%s3)
    %sz = sext i64 %av3
    br setup(fr, tot, %sz)
  setup(fr: i64, tot: i64, S: i64):
    %npix = mul i64 S, S
    %nbytes = mul i64 %npix, 8
    %buf = call ptr malloc(%nbytes)
    call void zero_canvas(%buf, %npix)
    %rowb = mul i64 S, 3
    %row = call ptr malloc(%rowb)
    %frf = sitofp f64 fr
    %totf = sitofp f64 tot
    %ph = fdiv f64 %frf, %totf
    %rot = fmul f64 %ph, 6.283185307179586
    %br0 = fmul f64 %ph, 12.566370614359172
    %br1 = call f64 sin(%br0)
    %br2 = fmul f64 %br1, 0.035
    %pulse = fadd f64 %br2, 1.0
    call void seed_pass(%buf, S, %rot, %pulse, %ph)
    call void spiral_pass(%buf, S, %rot)
    call void wh1()
    call void print_u64(S)
    call void wsp()
    call void print_u64(S)
    call void wh2()
    br rows(0, %buf, S, %row, %rowb)
  rows(y: i64, buf: ptr, S: i64, row: ptr, rowb: i64):
    %done = icmp.sge i64 y, S
    condbr %done, fin(), rbody(y, buf, S, row, rowb)
  rbody(y: i64, buf: ptr, S: i64, row: ptr, rowb: i64):
    call void render_row(buf, S, y, row)
    %w = call i64 write(1, row, rowb)
    %y2 = add i64 y, 1
    br rows(%y2, buf, S, row, rowb)
  fin():
    ret 0
}
