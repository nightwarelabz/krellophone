fn print_u64(i64) -> void {
  entry(x: i64):
    %_s0 = iconst i64 0
    %_s1 = iconst i32 0
    %_s2 = iconst i8 0
    %_s3 = iconst i64 1
    %_s4 = iconst i32 1
    %_s5 = iconst i8 1
    %_s6 = iconst i64 10
    %_s7 = iconst i32 10
    %_s8 = iconst i8 10
    %_s9 = iconst i64 24
    %_s10 = iconst i32 24
    %_s11 = iconst i8 24
    %_s12 = iconst i64 32
    %_s13 = iconst i32 32
    %_s14 = iconst i8 32
    %_s15 = iconst i64 48
    %_s16 = iconst i32 48
    %_s17 = iconst i8 48
    %buf = call ptr malloc(32)
    %z = icmp.eq i64 x, 0
    condbr %z, zero(%buf), loop(24, x, %buf)
  zero(buf: ptr):
    %p = gep i8 buf, 0
    store i8 %p, 48
    %w = call i64 write(1, buf, 1)
    ret
  loop(pos: i64, x: i64, buf: ptr):
    %done = icmp.sle i64 x, 0
    condbr %done, dump(pos, buf), body(pos, x, buf)
  body(pos: i64, x: i64, buf: ptr):
    %d = urem i64 x, 10
    %ch = add i64 %d, 48
    %ch8 = trunc i8 %ch
    %p2 = sub i64 pos, 1
    %pp = gep i8 buf, %p2
    store i8 %pp, %ch8
    %x2 = udiv i64 x, 10
    br loop(%p2, %x2, buf)
  dump(pos: i64, buf: ptr):
    %pp = gep i8 buf, pos
    %len = sub i64 24, pos
    %w = call i64 write(1, %pp, %len)
    ret
}

fn clamp01(f64) -> f64 {
  entry(v: f64):
    %_s0 = fconst f64 0.0
    %_s1 = fconst f64 1.0
    %lo = fcmp.olt f64 v, 0.0
    %a = select f64 %lo, 0.0, v
    %hi = fcmp.ogt f64 %a, 1.0
    %b = select f64 %hi, 1.0, %a
    ret %b
}

fn clamp255(f64) -> f64 {
  entry(v: f64):
    %_s0 = fconst f64 0.0
    %_s1 = fconst f64 255.0
    %lo = fcmp.olt f64 v, 0.0
    %a = select f64 %lo, 0.0, v
    %hi = fcmp.ogt f64 %a, 255.0
    %b = select f64 %hi, 255.0, %a
    ret %b
}

fn zero_canvas(ptr, i64) -> void {
  entry(buf: ptr, n: i64):
    %_s0 = iconst i64 0
    %_s1 = iconst i32 0
    %_s2 = iconst i8 0
    %_s3 = iconst i64 1
    %_s4 = iconst i32 1
    %_s5 = iconst i8 1
    %_s6 = fconst f64 0.0
    br loop(0, buf, n)
  loop(i: i64, buf: ptr, n: i64):
    %done = icmp.sge i64 i, n
    condbr %done, fin(), body(i, buf, n)
  body(i: i64, buf: ptr, n: i64):
    %p = gep f64 buf, i
    store f64 %p, 0.0
    %i2 = add i64 i, 1
    br loop(%i2, buf, n)
  fin():
    ret
}

; soft 5x5 stamp into the float canvas at (ix, iy); caller
; guarantees 2 <= ix, iy <= S-3.
fn splat(ptr, i64, i64, i64, f64) -> void {
  entry(buf: ptr, S: i64, ix: i64, iy: i64, w: f64):
    %_s0 = iconst i64 1
    %_s1 = iconst i32 1
    %_s2 = iconst i8 1
    %_s3 = iconst i64 2
    %_s4 = iconst i32 2
    %_s5 = iconst i8 2
    %_s6 = fconst f64 0.03
    %_s7 = fconst f64 0.05
    %_s8 = fconst f64 0.1
    %_s9 = fconst f64 0.22
    %_s10 = fconst f64 0.45
    %row = mul i64 iy, S
    %c = add i64 %row, ix
    %s2 = mul i64 S, 2
    %rm2 = sub i64 %c, %s2
    %rm1 = sub i64 %c, S
    %rp1 = add i64 %c, S
    %rp2 = add i64 %c, %s2
    %a0 = gep f64 buf, %c
    %v0 = load f64, %a0
    %n0 = fadd f64 %v0, w
    store f64 %a0, %n0
    %t1 = add i64 %c, 1
    %w1 = fmul f64 w, 0.45
    %a1 = gep f64 buf, %t1
    %v1 = load f64, %a1
    %n1 = fadd f64 %v1, %w1
    store f64 %a1, %n1
    %t2 = sub i64 %c, 1
    %w2 = fmul f64 w, 0.45
    %a2 = gep f64 buf, %t2
    %v2 = load f64, %a2
    %n2 = fadd f64 %v2, %w2
    store f64 %a2, %n2
    %w3 = fmul f64 w, 0.45
    %a3 = gep f64 buf, %rp1
    %v3 = load f64, %a3
    %n3 = fadd f64 %v3, %w3
    store f64 %a3, %n3
    %w4 = fmul f64 w, 0.45
    %a4 = gep f64 buf, %rm1
    %v4 = load f64, %a4
    %n4 = fadd f64 %v4, %w4
    store f64 %a4, %n4
    %t5 = add i64 %rp1, 1
    %w5 = fmul f64 w, 0.22
    %a5 = gep f64 buf, %t5
    %v5 = load f64, %a5
    %n5 = fadd f64 %v5, %w5
    store f64 %a5, %n5
    %t6 = add i64 %rm1, 1
    %w6 = fmul f64 w, 0.22
    %a6 = gep f64 buf, %t6
    %v6 = load f64, %a6
    %n6 = fadd f64 %v6, %w6
    store f64 %a6, %n6
    %t7 = sub i64 %rp1, 1
    %w7 = fmul f64 w, 0.22
    %a7 = gep f64 buf, %t7
    %v7 = load f64, %a7
    %n7 = fadd f64 %v7, %w7
    store f64 %a7, %n7
    %t8 = sub i64 %rm1, 1
    %w8 = fmul f64 w, 0.22
    %a8 = gep f64 buf, %t8
    %v8 = load f64, %a8
    %n8 = fadd f64 %v8, %w8
    store f64 %a8, %n8
    %t9 = add i64 %c, 2
    %w9 = fmul f64 w, 0.1
    %a9 = gep f64 buf, %t9
    %v9 = load f64, %a9
    %n9 = fadd f64 %v9, %w9
    store f64 %a9, %n9
    %t10 = sub i64 %c, 2
    %w10 = fmul f64 w, 0.1
    %a10 = gep f64 buf, %t10
    %v10 = load f64, %a10
    %n10 = fadd f64 %v10, %w10
    store f64 %a10, %n10
    %w11 = fmul f64 w, 0.1
    %a11 = gep f64 buf, %rp2
    %v11 = load f64, %a11
    %n11 = fadd f64 %v11, %w11
    store f64 %a11, %n11
    %w12 = fmul f64 w, 0.1
    %a12 = gep f64 buf, %rm2
    %v12 = load f64, %a12
    %n12 = fadd f64 %v12, %w12
    store f64 %a12, %n12
    %t13 = add i64 %rp1, 2
    %w13 = fmul f64 w, 0.05
    %a13 = gep f64 buf, %t13
    %v13 = load f64, %a13
    %n13 = fadd f64 %v13, %w13
    store f64 %a13, %n13
    %t14 = add i64 %rm1, 2
    %w14 = fmul f64 w, 0.05
    %a14 = gep f64 buf, %t14
    %v14 = load f64, %a14
    %n14 = fadd f64 %v14, %w14
    store f64 %a14, %n14
    %t15 = sub i64 %rp1, 2
    %w15 = fmul f64 w, 0.05
    %a15 = gep f64 buf, %t15
    %v15 = load f64, %a15
    %n15 = fadd f64 %v15, %w15
    store f64 %a15, %n15
    %t16 = sub i64 %rm1, 2
    %w16 = fmul f64 w, 0.05
    %a16 = gep f64 buf, %t16
    %v16 = load f64, %a16
    %n16 = fadd f64 %v16, %w16
    store f64 %a16, %n16
    %t17 = add i64 %rp2, 1
    %w17 = fmul f64 w, 0.05
    %a17 = gep f64 buf, %t17
    %v17 = load f64, %a17
    %n17 = fadd f64 %v17, %w17
    store f64 %a17, %n17
    %t18 = add i64 %rm2, 1
    %w18 = fmul f64 w, 0.05
    %a18 = gep f64 buf, %t18
    %v18 = load f64, %a18
    %n18 = fadd f64 %v18, %w18
    store f64 %a18, %n18
    %t19 = sub i64 %rp2, 1
    %w19 = fmul f64 w, 0.05
    %a19 = gep f64 buf, %t19
    %v19 = load f64, %a19
    %n19 = fadd f64 %v19, %w19
    store f64 %a19, %n19
    %t20 = sub i64 %rm2, 1
    %w20 = fmul f64 w, 0.05
    %a20 = gep f64 buf, %t20
    %v20 = load f64, %a20
    %n20 = fadd f64 %v20, %w20
    store f64 %a20, %n20
    %t21 = add i64 %rp2, 2
    %w21 = fmul f64 w, 0.03
    %a21 = gep f64 buf, %t21
    %v21 = load f64, %a21
    %n21 = fadd f64 %v21, %w21
    store f64 %a21, %n21
    %t22 = add i64 %rm2, 2
    %w22 = fmul f64 w, 0.03
    %a22 = gep f64 buf, %t22
    %v22 = load f64, %a22
    %n22 = fadd f64 %v22, %w22
    store f64 %a22, %n22
    %t23 = sub i64 %rp2, 2
    %w23 = fmul f64 w, 0.03
    %a23 = gep f64 buf, %t23
    %v23 = load f64, %a23
    %n23 = fadd f64 %v23, %w23
    store f64 %a23, %n23
    %t24 = sub i64 %rm2, 2
    %w24 = fmul f64 w, 0.03
    %a24 = gep f64 buf, %t24
    %v24 = load f64, %a24
    %n24 = fadd f64 %v24, %w24
    store f64 %a24, %n24
    ret
}

; analyze the music at this frame, in Krell, from the note tables.
; glo: [0]=E low [1]=E mid [2]=E high [3]=E all [4]=onset [5]=t seconds
fn analyze(i64, ptr) -> void {
  entry(fr: i64, glo: ptr):
    %_s0 = iconst i64 0
    %_s1 = iconst i32 0
    %_s2 = iconst i8 0
    %_s3 = iconst i64 1
    %_s4 = iconst i32 1
    %_s5 = iconst i8 1
    %_s6 = iconst i64 2
    %_s7 = iconst i32 2
    %_s8 = iconst i8 2
    %_s9 = iconst i64 3
    %_s10 = iconst i32 3
    %_s11 = iconst i8 3
    %_s12 = iconst i64 4
    %_s13 = iconst i32 4
    %_s14 = iconst i8 4
    %_s15 = iconst i64 5
    %_s16 = iconst i32 5
    %_s17 = iconst i8 5
    %_s18 = iconst i64 6
    %_s19 = iconst i32 6
    %_s20 = iconst i8 6
    %_s21 = iconst i64 7
    %_s22 = iconst i32 7
    %_s23 = iconst i8 7
    %_s24 = iconst i64 48
    %_s25 = iconst i32 48
    %_s26 = iconst i8 48
    %_s27 = iconst i64 72
    %_s28 = iconst i32 72
    %_s29 = iconst i8 72
    %_s30 = fconst f64 0.0
    %_s31 = fconst f64 0.35
    %_s32 = fconst f64 0.55
    %_s33 = fconst f64 0.7
    %_s34 = fconst f64 0.95
    %_s35 = fconst f64 1.0
    %_s36 = fconst f64 1.1
    %_s37 = fconst f64 1.35
    %_s38 = fconst f64 1.8
    %_s39 = fconst f64 114.0
    %_s40 = fconst f64 1837.5
    %_s41 = fconst f64 2.4
    %_s42 = fconst f64 24.0
    %_s43 = fconst f64 4.0
    %_s44 = fconst f64 44100.0
    %ps = dataptr 3
    %pd = dataptr 4
    %pn = dataptr 5
    %pv = dataptr 6
    %pc = dataptr 7
    %cp = gep i32 %pc, 0
    %cnt32 = load i32, %cp
    %cnt = sext i64 %cnt32
    %frf = sitofp f64 fr
    %pos = fmul f64 %frf, 1837.5
    %tf = fdiv f64 %frf, 24.0
    br loop(0, %cnt, %pos, %tf, glo, %ps, %pd, %pn, %pv, 0.0, 0.0, 0.0, 0.0)
  loop(i: i64, cnt: i64, pos: f64, tf: f64, glo: ptr, ps: ptr, pd: ptr, pn: ptr, pv: ptr, al: f64, am: f64, ah: f64, ons: f64):
    %done = icmp.sge i64 i, cnt
    condbr %done, fin(cnt, pos, tf, glo, ps, pd, pn, pv, al, am, ah, ons), body(i, cnt, pos, tf, glo, ps, pd, pn, pv, al, am, ah, ons)
  body(i: i64, cnt: i64, pos: f64, tf: f64, glo: ptr, ps: ptr, pd: ptr, pn: ptr, pv: ptr, al: f64, am: f64, ah: f64, ons: f64):
    %sp = gep i32 ps, i
    %st32 = load i32, %sp
    %st = sitofp f64 %st32
    %age0 = fsub f64 pos, %st
    %age = fdiv f64 %age0, 44100.0
    %future = fcmp.olt f64 %age, 0.0
    condbr %future, fin(cnt, pos, tf, glo, ps, pd, pn, pv, al, am, ah, ons), act(i, cnt, pos, tf, glo, ps, pd, pn, pv, al, am, ah, ons, %age)
  act(i: i64, cnt: i64, pos: f64, tf: f64, glo: ptr, ps: ptr, pd: ptr, pn: ptr, pv: ptr, al: f64, am: f64, ah: f64, ons: f64, age: f64):
    %dp = gep i32 pd, i
    %du32 = load i32, %dp
    %du = sitofp f64 %du32
    %durs = fdiv f64 %du, 44100.0
    %win = fadd f64 %durs, 4.0
    %inwin = fcmp.olt f64 age, %win
    %np = gep i8 pn, i
    %n8 = load i8, %np
    %n = sext i64 %n8
    %nf = sitofp f64 %n
    %islow = icmp.slt i64 %n, 48
    %ishigh = icmp.sge i64 %n, 72
    %tau0 = select f64 %ishigh, 0.7, 1.1
    %tau = select f64 %islow, 1.8, %tau0
    %vp = gep i8 pv, i
    %v8 = load i8, %vp
    %v = sext i64 %v8
    %vf = sitofp f64 %v
    %veln = fdiv f64 %vf, 114.0
    %w = fmul f64 %veln, %veln
    %na = fsub f64 0.0, %age
    %ex0 = fdiv f64 %na, %tau
    %env = call f64 exp(%ex0)
    %contrib0 = fmul f64 %w, %env
    %contrib = select f64 %inwin, %contrib0, 0.0
    %ml64 = zext i64 %islow
    %ml = sitofp f64 %ml64
    %mh64 = zext i64 %ishigh
    %mh = sitofp f64 %mh64
    %notl = fsub f64 1.0, %ml
    %noth = fsub f64 1.0, %mh
    %mm = fmul f64 %notl, %noth
    %cl = fmul f64 %contrib, %ml
    %al2 = fadd f64 al, %cl
    %cm = fmul f64 %contrib, %mm
    %am2 = fadd f64 am, %cm
    %chv = fmul f64 %contrib, %mh
    %ah2 = fadd f64 ah, %chv
    %isOn = fcmp.olt f64 age, 0.35
    %of0 = fdiv f64 age, 0.35
    %of1 = fsub f64 1.0, %of0
    %oc = fmul f64 %w, %of1
    %oc2 = select f64 %isOn, %oc, 0.0
    %ons2 = fadd f64 ons, %oc2
    %i2 = add i64 i, 1
    br loop(%i2, cnt, pos, tf, glo, ps, pd, pn, pv, %al2, %am2, %ah2, %ons2)
  fin(cnt: i64, pos: f64, tf: f64, glo: ptr, ps: ptr, pd: ptr, pn: ptr, pv: ptr, al: f64, am: f64, ah: f64, ons: f64):
    %el0 = fdiv f64 al, 1.35
    %el = call f64 clamp01(%el0)
    %em0 = fdiv f64 am, 2.4
    %em = call f64 clamp01(%em0)
    %eh0 = fdiv f64 ah, 0.95
    %eh = call f64 clamp01(%eh0)
    %eo0 = fdiv f64 ons, 1.8
    %eo = call f64 clamp01(%eo0)
    %ea0 = fadd f64 %el, %em
    %ea1 = fadd f64 %ea0, %eh
    %ea2 = fmul f64 %ea1, 0.55
    %ea = call f64 clamp01(%ea2)
    %g0 = gep f64 glo, 0
    store f64 %g0, %el
    %g1 = gep f64 glo, 1
    store f64 %g1, %em
    %g2 = gep f64 glo, 2
    store f64 %g2, %eh
    %g3 = gep f64 glo, 3
    store f64 %g3, %ea
    %g4 = gep f64 glo, 4
    store f64 %g4, %eo
    %g5 = gep f64 glo, 5
    store f64 %g5, tf
    ret
}

; 2584 = F(18) phyllotaxis seeds, each pulsating with its register band.
fn seed_pass(ptr, i64, f64, ptr) -> void {
  entry(buf: ptr, S: i64, rot: f64, glo: ptr):
    %_s0 = iconst i64 0
    %_s1 = iconst i32 0
    %_s2 = iconst i8 0
    %_s3 = iconst i64 1
    %_s4 = iconst i32 1
    %_s5 = iconst i8 1
    %_s6 = iconst i64 2
    %_s7 = iconst i32 2
    %_s8 = iconst i8 2
    %_s9 = iconst i64 5
    %_s10 = iconst i32 5
    %_s11 = iconst i8 5
    %_s12 = iconst i64 2584
    %_s13 = iconst i32 2584
    %_s14 = iconst i8 2584
    %_s15 = fconst f64 0.15
    %_s16 = fconst f64 0.30
    %_s17 = fconst f64 0.45
    %_s18 = fconst f64 0.46
    %_s19 = fconst f64 0.5
    %_s20 = fconst f64 0.55
    %_s21 = fconst f64 0.6180339887498949
    %_s22 = fconst f64 0.9
    %_s23 = fconst f64 0.95
    %_s24 = fconst f64 1.05
    %_s25 = fconst f64 1.18
    %_s26 = fconst f64 2.0
    %_s27 = fconst f64 2.39996322972865332
    %_s28 = fconst f64 2584.0
    %_s29 = fconst f64 3.0
    %_s30 = fconst f64 6.283185307179586
    %sf = sitofp f64 S
    %rmax = fmul f64 %sf, 0.46
    %half = fmul f64 %sf, 0.5
    %e0p = gep f64 glo, 0
    %el = load f64, %e0p
    %e1p = gep f64 glo, 1
    %em = load f64, %e1p
    %e2p = gep f64 glo, 2
    %eh = load f64, %e2p
    %e5p = gep f64 glo, 5
    %tf = load f64, %e5p
    br loop(0, buf, S, rot, %rmax, %half, %el, %em, %eh, %tf)
  loop(k: i64, buf: ptr, S: i64, rot: f64, rmax: f64, half: f64, el: f64, em: f64, eh: f64, tf: f64):
    %done = icmp.sge i64 k, 2584
    condbr %done, fin(), body(k, buf, S, rot, rmax, half, el, em, eh, tf)
  body(k: i64, buf: ptr, S: i64, rot: f64, rmax: f64, half: f64, el: f64, em: f64, eh: f64, tf: f64):
    %kf = sitofp f64 k
    %kp = fadd f64 %kf, 0.5
    %fr0 = fdiv f64 %kp, 2584.0
    %fr = call f64 sqrt(%fr0)
    %r = fmul f64 %fr, rmax
    %ang0 = fmul f64 %kf, 2.39996322972865332
    %ang = fadd f64 %ang0, rot
    %ca = call f64 cos(%ang)
    %sa = call f64 sin(%ang)
    %dx = fmul f64 %r, %ca
    %dy = fmul f64 %r, %sa
    %x = fadd f64 half, %dx
    %y = fadd f64 half, %dy
    %lo = fcmp.olt f64 %fr, 0.5
    %b10 = fsub f64 em, el
    %b11 = fmul f64 %fr, 2.0
    %b12 = fmul f64 %b10, %b11
    %b1 = fadd f64 el, %b12
    %b20 = fsub f64 eh, em
    %b21 = fsub f64 %fr, 0.5
    %b22 = fmul f64 %b21, 2.0
    %b23 = fmul f64 %b20, %b22
    %b2 = fadd f64 em, %b23
    %eb = select f64 %lo, %b1, %b2
    %wv0 = fmul f64 %fr, 3.0
    %wv1 = fmul f64 tf, 0.45
    %wv2 = fsub f64 %wv0, %wv1
    %wv3 = fmul f64 %wv2, 6.283185307179586
    %wv4 = call f64 sin(%wv3)
    %wv5 = fmul f64 %wv4, 0.5
    %wv = fadd f64 %wv5, 0.5
    %br0 = fmul f64 %eb, 0.95
    %br1 = fadd f64 %br0, 1.05
    %br2 = fmul f64 %br1, %wv
    %br3 = fmul f64 %eb, %br2
    %bright = fadd f64 %br3, 0.30
    %tw0 = fmul f64 tf, 0.9
    %tw1 = fmul f64 %kf, 0.6180339887498949
    %tw2 = fadd f64 %tw0, %tw1
    %tw3 = call f64 sin(%tw2)
    %tw4 = fmul f64 %tw3, 0.15
    %tw = fadd f64 %tw4, 0.9
    %fall0 = fmul f64 %fr, 0.55
    %fall = fsub f64 1.18, %fall0
    %w0 = fmul f64 %tw, %fall
    %w = fmul f64 %w0, %bright
    %ix = fptosi i64 %x
    %iy = fptosi i64 %y
    call void splat(buf, S, %ix, %iy, %w)
    %k2 = add i64 k, 1
    br loop(%k2, buf, S, rot, rmax, half, el, em, eh, tf)
  fin():
    ret
}

; the golden log spiral, breathing with the total musical energy.
fn spiral_pass(ptr, i64, f64, ptr) -> void {
  entry(buf: ptr, S: i64, rot: f64, glo: ptr):
    %_s0 = iconst i64 0
    %_s1 = iconst i32 0
    %_s2 = iconst i8 0
    %_s3 = iconst i64 1
    %_s4 = iconst i32 1
    %_s5 = iconst i8 1
    %_s6 = iconst i64 3
    %_s7 = iconst i32 3
    %_s8 = iconst i8 3
    %_s9 = iconst i64 9000
    %_s10 = iconst i32 9000
    %_s11 = iconst i8 9000
    %_s12 = fconst f64 0.00362
    %_s13 = fconst f64 0.03
    %_s14 = fconst f64 0.13
    %_s15 = fconst f64 0.1532
    %_s16 = fconst f64 0.30
    %_s17 = fconst f64 0.46
    %_s18 = fconst f64 0.5
    %_s19 = fconst f64 0.95
    %_s20 = fconst f64 1.0
    %_s21 = fconst f64 147.1
    %sf = sitofp f64 S
    %rmax = fmul f64 %sf, 0.46
    %half = fmul f64 %sf, 0.5
    %rscale = fdiv f64 %rmax, 147.1
    %e3p = gep f64 glo, 3
    %ea = load f64, %e3p
    %gain0 = fmul f64 %ea, 0.95
    %gain = fadd f64 %gain0, 0.30
    br loop(0, buf, S, rot, %rmax, %half, %rscale, %gain)
  loop(s: i64, buf: ptr, S: i64, rot: f64, rmax: f64, half: f64, rscale: f64, gain: f64):
    %done = icmp.sge i64 s, 9000
    condbr %done, fin(), body(s, buf, S, rot, rmax, half, rscale, gain)
  body(s: i64, buf: ptr, S: i64, rot: f64, rmax: f64, half: f64, rscale: f64, gain: f64):
    %sf2 = sitofp f64 s
    %th = fmul f64 %sf2, 0.00362
    %ex0 = fmul f64 %th, 0.1532
    %ex = call f64 exp(%ex0)
    %r = fmul f64 %ex, rscale
    %ang = fsub f64 %th, rot
    %ca = call f64 cos(%ang)
    %sa = call f64 sin(%ang)
    %dx = fmul f64 %r, %ca
    %dy = fmul f64 %r, %sa
    %x = fadd f64 half, %dx
    %y = fadd f64 half, %dy
    %fd0 = fdiv f64 %r, rmax
    %fd1 = fsub f64 1.0, %fd0
    %fd2 = fmul f64 %fd1, 0.13
    %w0 = fadd f64 %fd2, 0.03
    %w = fmul f64 %w0, gain
    %ix = fptosi i64 %x
    %iy = fptosi i64 %y
    call void splat(buf, S, %ix, %iy, %w)
    %s2 = add i64 s, 1
    br loop(%s2, buf, S, rot, rmax, half, rscale, gain)
  fin():
    ret
}

; one pixel: deep blue field, anamorphic wave sheets, the horizontal
; anamorphic streak through the core, and the blue dot light itself.
fn shade(ptr, i64, i64, i64, ptr, ptr) -> void {
  entry(buf: ptr, S: i64, x: i64, y: i64, row: ptr, glo: ptr):
    %_s0 = iconst i64 1
    %_s1 = iconst i32 1
    %_s2 = iconst i8 1
    %_s3 = iconst i64 2
    %_s4 = iconst i32 2
    %_s5 = iconst i8 2
    %_s6 = iconst i64 3
    %_s7 = iconst i32 3
    %_s8 = iconst i8 3
    %_s9 = iconst i64 4
    %_s10 = iconst i32 4
    %_s11 = iconst i8 4
    %_s12 = iconst i64 5
    %_s13 = iconst i32 5
    %_s14 = iconst i8 5
    %_s15 = fconst f64 0.0
    %_s16 = fconst f64 0.30
    %_s17 = fconst f64 0.5
    %_s18 = fconst f64 0.8
    %_s19 = fconst f64 0.85
    %_s20 = fconst f64 1.0
    %_s21 = fconst f64 1.5
    %_s22 = fconst f64 10.0
    %_s23 = fconst f64 118.0
    %_s24 = fconst f64 12.0
    %_s25 = fconst f64 120.0
    %_s26 = fconst f64 175.0
    %_s27 = fconst f64 20.0
    %_s28 = fconst f64 205.0
    %_s29 = fconst f64 240.0
    %_s30 = fconst f64 255.0
    %_s31 = fconst f64 3.5
    %_s32 = fconst f64 30.0
    %_s33 = fconst f64 4.0
    %_s34 = fconst f64 46.0
    %_s35 = fconst f64 6.283185307179586
    %_s36 = fconst f64 70.0
    %_s37 = fconst f64 900.0
    %idx0 = mul i64 y, S
    %idx = add i64 %idx0, x
    %cp = gep f64 buf, %idx
    %v = load f64, %cp
    %e3p = gep f64 glo, 3
    %ea = load f64, %e3p
    %e4p = gep f64 glo, 4
    %eo = load f64, %e4p
    %e5p = gep f64 glo, 5
    %tf = load f64, %e5p
    %sf = sitofp f64 S
    %half = fmul f64 %sf, 0.5
    %xf = sitofp f64 x
    %yf = sitofp f64 y
    %dx0 = fsub f64 %xf, %half
    %dx = fdiv f64 %dx0, %half
    %dy0 = fsub f64 %yf, %half
    %dy = fdiv f64 %dy0, %half
    %dx2 = fmul f64 %dx, %dx
    %dy2 = fmul f64 %dy, %dy
    %d2 = fadd f64 %dx2, %dy2
    %d = call f64 sqrt(%d2)
    %t0 = fsub f64 1.0, %d
    %t = call f64 clamp01(%t0)
    %t2 = fmul f64 %t, %t
    %bgr0 = fmul f64 %t2, 10.0
    %bgr = fadd f64 %bgr0, 4.0
    %bgg0 = fmul f64 %t2, 20.0
    %bgg = fadd f64 %bgg0, 10.0
    %bgb0 = fmul f64 %t2, 46.0
    %bgb = fadd f64 %bgb0, 30.0
    %ws0 = fmul f64 %d, 4.0
    %ws1 = fmul f64 tf, 0.8
    %ws2 = fsub f64 %ws0, %ws1
    %ws3 = fmul f64 %ws2, 6.283185307179586
    %ws4 = call f64 sin(%ws3)
    %ws5 = fmul f64 %ws4, 0.5
    %ws6 = fadd f64 %ws5, 0.5
    %wp2 = fmul f64 %ws6, %ws6
    %wp4 = fmul f64 %wp2, %wp2
    %wp6 = fmul f64 %wp4, %wp2
    %wfall = fsub f64 1.0, %d
    %wfc = call f64 clamp01(%wfall)
    %wamp0 = fmul f64 %ea, %wp6
    %wamp = fmul f64 %wamp0, %wfc
    %wab = fmul f64 %wamp, 30.0
    %wag = fmul f64 %wamp, 12.0
    %dy9 = fmul f64 %dy2, 900.0
    %ndy = fsub f64 0.0, %dy9
    %sexp = call f64 exp(%ndy)
    %dxneg = fsub f64 0.0, %dx
    %isneg = fcmp.olt f64 %dx, 0.0
    %adx = select f64 %isneg, %dxneg, %dx
    %sden = fmul f64 %adx, 3.5
    %sden1 = fadd f64 %sden, 1.0
    %sf0 = fdiv f64 %sexp, %sden1
    %sg0 = fmul f64 %eo, 0.85
    %sg1 = fmul f64 %ea, 0.30
    %sg = fadd f64 %sg0, %sg1
    %sfac = fmul f64 %sf0, %sg
    %str = fmul f64 %sfac, 70.0
    %stg = fmul f64 %sfac, 120.0
    %stb = fmul f64 %sfac, 240.0
    %e0 = fmul f64 %v, 1.5
    %e1 = fsub f64 0.0, %e0
    %e2 = call f64 exp(%e1)
    %g = fsub f64 1.0, %e2
    %h = fmul f64 %g, %g
    %ar = fmul f64 %g, 46.0
    %ag = fmul f64 %g, 118.0
    %ab = fmul f64 %g, 255.0
    %hr = fmul f64 %h, 175.0
    %hg = fmul f64 %h, 205.0
    %hb = fmul f64 %h, 255.0
    %vg0 = fmul f64 %d2, 0.30
    %vg = fsub f64 1.0, %vg0
    %rr0 = fadd f64 %bgr, %ar
    %rr1 = fadd f64 %rr0, %hr
    %rr2 = fadd f64 %rr1, %str
    %rr = fmul f64 %rr2, %vg
    %gg0 = fadd f64 %bgg, %ag
    %gg1 = fadd f64 %gg0, %hg
    %gg2 = fadd f64 %gg1, %stg
    %gg3 = fadd f64 %gg2, %wag
    %gg = fmul f64 %gg3, %vg
    %bb0 = fadd f64 %bgb, %ab
    %bb1 = fadd f64 %bb0, %hb
    %bb2 = fadd f64 %bb1, %stb
    %bb3 = fadd f64 %bb2, %wab
    %bb = fmul f64 %bb3, %vg
    %rc = call f64 clamp255(%rr)
    %gc = call f64 clamp255(%gg)
    %bc = call f64 clamp255(%bb)
    %ri = fptosi i64 %rc
    %gi = fptosi i64 %gc
    %bi = fptosi i64 %bc
    %o0 = mul i64 x, 3
    %rp = gep i8 row, %o0
    %r8 = trunc i8 %ri
    store i8 %rp, %r8
    %o1 = add i64 %o0, 1
    %gp = gep i8 row, %o1
    %g8 = trunc i8 %gi
    store i8 %gp, %g8
    %o2 = add i64 %o0, 2
    %bp = gep i8 row, %o2
    %b8 = trunc i8 %bi
    store i8 %bp, %b8
    ret
}

fn render_row(ptr, i64, i64, ptr, ptr) -> void {
  entry(buf: ptr, S: i64, y: i64, row: ptr, glo: ptr):
    %_s0 = iconst i64 0
    %_s1 = iconst i32 0
    %_s2 = iconst i8 0
    %_s3 = iconst i64 1
    %_s4 = iconst i32 1
    %_s5 = iconst i8 1
    br loop(0, buf, S, y, row, glo)
  loop(x: i64, buf: ptr, S: i64, y: i64, row: ptr, glo: ptr):
    %done = icmp.sge i64 x, S
    condbr %done, fin(), body(x, buf, S, y, row, glo)
  body(x: i64, buf: ptr, S: i64, y: i64, row: ptr, glo: ptr):
    call void shade(buf, S, x, y, row, glo)
    %x2 = add i64 x, 1
    br loop(%x2, buf, S, y, row, glo)
  fin():
    ret
}

fn main(i32, ptr) -> i32 {
  entry(argc: i32, argv: ptr):
    %_s0 = iconst i64 0
    %_s1 = iconst i32 0
    %_s2 = iconst i8 0
    %_s3 = iconst i64 1
    %_s4 = iconst i32 1
    %_s5 = iconst i8 1
    %_s6 = iconst i64 2
    %_s7 = iconst i32 2
    %_s8 = iconst i8 2
    %_s9 = iconst i64 3
    %_s10 = iconst i32 3
    %_s11 = iconst i8 3
    %_s12 = iconst i64 4
    %_s13 = iconst i32 4
    %_s14 = iconst i8 4
    %_s15 = iconst i64 8
    %_s16 = iconst i32 8
    %_s17 = iconst i8 8
    %_s18 = iconst i64 64
    %_s19 = iconst i32 64
    %_s20 = iconst i8 64
    %_s21 = iconst i64 960
    %_s22 = iconst i32 960
    %_s23 = iconst i8 960
    %_s24 = iconst i64 6696
    %_s25 = iconst i32 6696
    %_s26 = iconst i8 6696
    %_s27 = fconst f64 6.283185307179586
    %h1 = icmp.sge i32 argc, 2
    condbr %h1, a1(argc, argv), setup(0, 6696, 960)
  a1(argc: i32, argv: ptr):
    %p1 = gep ptr argv, 1
    %s1 = load ptr, %p1
    %av1 = call i32 atoi(%s1)
    %fr = sext i64 %av1
    %h2 = icmp.sge i32 argc, 3
    condbr %h2, a2(argc, argv, %fr), setup(%fr, 6696, 960)
  a2(argc: i32, argv: ptr, fr: i64):
    %p2 = gep ptr argv, 2
    %s2 = load ptr, %p2
    %av2 = call i32 atoi(%s2)
    %tot = sext i64 %av2
    %h3 = icmp.sge i32 argc, 4
    condbr %h3, a3(argv, fr, %tot), setup(fr, %tot, 960)
  a3(argv: ptr, fr: i64, tot: i64):
    %p3 = gep ptr argv, 3
    %s3 = load ptr, %p3
    %av3 = call i32 atoi(%s3)
    %sz = sext i64 %av3
    br setup(fr, tot, %sz)
  setup(fr: i64, tot: i64, S: i64):
    %npix = mul i64 S, S
    %nbytes = mul i64 %npix, 8
    %buf = call ptr malloc(%nbytes)
    call void zero_canvas(%buf, %npix)
    %rowb = mul i64 S, 3
    %row = call ptr malloc(%rowb)
    %glo = call ptr malloc(64)
    call void analyze(fr, %glo)
    %frf = sitofp f64 fr
    %totf = sitofp f64 tot
    %ph = fdiv f64 %frf, %totf
    %rot = fmul f64 %ph, 6.283185307179586
    call void seed_pass(%buf, S, %rot, %glo)
    call void spiral_pass(%buf, S, %rot, %glo)
    call void wh1()
    call void print_u64(S)
    call void wsp()
    call void print_u64(S)
    call void wh2()
    br rows(0, %buf, S, %row, %rowb, %glo)
  rows(y: i64, buf: ptr, S: i64, row: ptr, rowb: i64, glo: ptr):
    %done = icmp.sge i64 y, S
    condbr %done, fin(), rbody(y, buf, S, row, rowb, glo)
  rbody(y: i64, buf: ptr, S: i64, row: ptr, rowb: i64, glo: ptr):
    call void render_row(buf, S, y, row, glo)
    %w = call i64 write(1, row, rowb)
    %y2 = add i64 y, 1
    br rows(%y2, buf, S, row, rowb, glo)
  fin():
    ret 0
}
