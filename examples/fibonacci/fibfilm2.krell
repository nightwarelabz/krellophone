fn wh1() -> void {
  entry():
    %_s0 = iconst i64 0
    %_s1 = iconst i32 0
    %_s2 = iconst i8 0
    %_s3 = iconst i64 1
    %_s4 = iconst i32 1
    %_s5 = iconst i8 1
    %_s6 = iconst i64 3
    %_s7 = iconst i32 3
    %_s8 = iconst i8 3
    %p = dataptr 0
    %r = call i64 write(1, %p, 3)
    ret
}
fn wsp() -> void {
