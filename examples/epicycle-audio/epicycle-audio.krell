; One sample of the series: sum every partial, advance every
; phase inside [-pi, pi].
fn mix1(ptr, ptr, ptr, ptr, f64) -> f64 {
  entry(ph: ptr, inc: ptr, gn: ptr, bl: ptr, bloom: f64):
    %one = iconst i64 1
    br loop(0, 0.0, ph, inc, gn, bl, bloom)
  loop(j: i64, m: f64, ph: ptr, inc: ptr, gn: ptr, bl: ptr, bloom: f64):
    %done = icmp.sge i64 j, 48
    condbr %done, fin(%m), body(j, m, ph, inc, gn, bl, bloom)
  body(j: i64, m: f64, ph: ptr, inc: ptr, gn: ptr, bl: ptr, bloom: f64):
    %ap = gep f64 ph, j
    %p = load f64, %ap
    %s = call f64 ksin(%p)
    %ag = gep f64 gn, j
    %g = load f64, %ag
    %ab = gep f64 bl, j
    %b = load f64, %ab
    %ge = fma f64 %bloom, %b, 1.0
    %gg = fmul f64 %g, %ge
    %m2 = fma f64 %gg, %s, m
    %ai = gep f64 inc, j
    %st = load f64, %ai
    %pn = fadd f64 %p, %st
    %over = fcmp.ogt f64 %pn, 3.141592653589793
    %pw = fadd f64 %pn, -6.283185307179586
    %pf = select f64 %over, %pw, %pn
    store f64 %ap, %pf
    %j2 = add i64 j, 1
    br loop(%j2, %m2, ph, inc, gn, bl, bloom)
  fin(m: f64):
    ret %m
}

fn main(i32, ptr) -> i32 {
  entry(argc: i32, argv: ptr):
    %one = iconst i64 1
    %z32 = iconst i32 0
    %o32 = iconst i32 1
    %inc = call ptr malloc(384)
    %gn = call ptr malloc(384)
    %bl = call ptr malloc(384)
    %ph = call ptr malloc(384)
    %buf = call ptr malloc(1058400)
    %pb = bitcast i64 %inc
    %ok = icmp.ne i64 %pb, 0
    condbr %ok, run(%inc, %gn, %bl, %ph, %buf), fail()
  run(inc: ptr, gn: ptr, bl: ptr, ph: ptr, buf: ptr):
    call void init_parts(inc, gn, bl, ph)
    br loop(0, inc, gn, bl, ph, buf)
  loop(n: i64, inc: ptr, gn: ptr, bl: ptr, ph: ptr, buf: ptr):
    %done = icmp.sge i64 n, 529200
    condbr %done, fin(buf), body(n, inc, gn, bl, ph, buf)
  body(n: i64, inc: ptr, gn: ptr, bl: ptr, ph: ptr, buf: ptr):
    %fn = sitofp f64 n
    %t = fmul f64 %fn, 0.000022675736961451247
    %bl0 = fsub f64 %t, 7.5
    %bl1 = fdiv f64 %bl0, 2.5
    %bl2 = call f64 clamp01(%bl1)
    %bloom = fmul f64 %bl2, 1.3
    %m = call f64 mix1(ph, inc, gn, bl, %bloom)
    %at0 = fdiv f64 %t, 1.5
    %at1 = call f64 clamp01(%at0)
    %atk = call f64 sstep(%at1)
    %rl0 = fsub f64 12.0, %t
    %rl1 = fdiv f64 %rl0, 2.5
    %rel = call f64 clamp01(%rl1)
    %env = fmul f64 %atk, %rel
    %mm = fmul f64 %m, %env
    %neg = fcmp.olt f64 %mm, 0.0
    %abs = select f64 %neg, %mm, %mm
    %abs2 = fsub f64 0.0, %abs
    %mag = select f64 %neg, %abs2, %mm
    %den = fadd f64 %mag, 1.0
    %y = fdiv f64 %mm, %den
    %sc = fmul f64 %y, 22000.0
    %si = fptosi i32 %sc
    %s16 = trunc i16 %si
    %addr = gep i16 buf, n
    store i16 %addr, %s16
    %n2 = add i64 n, 1
    br loop(%n2, inc, gn, bl, ph, buf)
  fin(buf: ptr):
    %wr = call i64 write(1, buf, 1058400)
    ret 0
  fail():
    ret 1
}
