; EPICYCLE, THE SOUND
; The mare's outline, heard. The video's soundtrack is the
; same Fourier series that draws her: every wheel of the
; drawing whose frequency falls in the audible band becomes
; a sine partial at 55 Hz times its frequency, with the gain
; and phase of the phasor itself. The great wheel is the deep
; root. The high wheels stay dim until the eye ignites at
; 7.5 seconds, when their gains bloom. Nothing here is an
; instrument; it is the symbol, transposed into air.
;
; 44100 Hz mono 16-bit PCM on stdout, exactly 12 seconds.
; Host services: write, malloc, free.

extern write(i32, ptr, i64) -> i64
extern malloc(i64) -> ptr
extern free(ptr) -> void

fn clamp01(f64) -> f64 {
  entry(v: f64):
    %lo = fcmp.olt f64 v, 0.0
    %a = select f64 %lo, 0.0, v
    %hi = fcmp.ogt f64 %a, 1.0
    %b = select f64 %hi, 1.0, %a
    ret %b
}

fn sstep(f64) -> f64 {
  entry(x: f64):
    %a = fmul f64 x, x
    %b = fma f64 -2.0, x, 3.0
    %r = fmul f64 %a, %b
    ret %r
}

fn ksin(f64) -> f64 {
  entry(x: f64):
    %x2 = fmul f64 x, x
    %c0 = fma f64 0.0000027557319223985893, %x2, -0.00019841269841269842
    %c1 = fma f64 %c0, %x2, 0.008333333333333334
    %c2 = fma f64 %c1, %x2, -0.16666666666666666
    %c3 = fma f64 %c2, %x2, 1.0
    %r = fmul f64 %c3, x
    ret %r
}

; The partial table: 48 wheels of the mare's spectrum.
; inc = phase step per sample, gn = gain, bl = bloom class,
; ph = starting phase, the phasor's own phase.
fn init_parts(ptr, ptr, ptr, ptr) -> void {
